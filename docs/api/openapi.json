  "components": {
    "schemas": {
      "CompletionResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "provider_type": {
            "type": "string",
            "enum": [
              "cloudflare",
              "ollama"
            ],
            "title": "Provider Type"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "sources": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "response",
          "provider",
          "provider_type",
          "model",
          "request_id",
          "attempts",
          "usage",
          "sources"
        ],
        "title": "CompletionResponse"
      },
      "Confirmation": {
        "properties": {
          "confirm": {
            "type": "boolean",
            "title": "Confirm"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm"
        ],
        "title": "Confirmation"
      },
      "ErrorDetails": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "upstream_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upstream Status"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetails"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetails"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "InferenceRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Prompt"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 512
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "default": 0.7
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "allow_fallback": {
            "type": "boolean",
            "title": "Allow Fallback",
            "default": false
          },
          "max_attempts": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Max Attempts",
            "default": 1
          },
          "web_enrichment": {
            "type": "boolean",
            "title": "Web Enrichment",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "InferenceRequest"
      },
      "Usage": {
        "properties": {
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "source": {
            "type": "string",
            "enum": [
              "provider",
              "unavailable"
            ],
            "title": "Source",
            "default": "unavailable"
          }
        },
        "type": "object",
        "title": "Usage"
      }
    },
    "securitySchemes": {
      "InferenceBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
